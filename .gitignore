# 푸시 불필요: 설치한 라이브러리, 빌드·테스트 결과, 로그
node_modules/
dist/
dist-ssr/
coverage/
*.log

# 푸시 불필요: Python 가상환경과 캐시
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# 푸시 불필요: 개인 IDE 설정과 운영체제 파일
.idea/
.DS_Store
Thumbs.db

# 푸시 금지: 실제 비밀키·비밀번호·토큰이 들어갈 환경 설정
.env
.env.*
# 실제 비밀값이 없는 설정 예시는 공유 가능
!.env.example
!.env.*.example

# 푸시 금지: 개인키와 인증서 키 묶음
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519

# 소스 코드, package.json, package-lock.json, .gitignore는 공유합니다.
# 팀에서 공유하기로 한 temp/ 폴더는 제외하지 않습니다.

