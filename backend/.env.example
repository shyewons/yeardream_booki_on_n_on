# 이 파일을 .env 로 복사해서 값을 채우세요. .env 는 Git에 올리지 않습니다(.gitignore).
# SSH 터널을 먼저 켜 두세요: ssh -N -L 3307:127.0.0.1:3306 이름@주소 -p 포트
# 비밀번호에 @ : / 같은 기호가 있으면 %40 처럼 바꿔 넣어야 합니다.
DATABASE_URL=mysql+pymysql://DB사용자:DB비밀번호@127.0.0.1:3307/app_db

# 선택: 한 쪽에 보여줄 개수 (기본 책 6, 글 10)
# PAGE_SIZE_BOOKS=6
# PAGE_SIZE_ENTRIES=10
# 선택: 로그인이 붙기 전까지 쓰는 더미 사용자 별명 (기본 dummy_user)
# DUMMY_NICKNAME=dummy_user

# 선택: 교정 모델 사용 (기본 0 = 임시 노드). 1 이면 requirements-models.txt 와 chroma_db 가 필요
# USE_MODELS=0
# 선택: RAG 벡터 DB(chroma_db) 폴더 위치. analysis 쪽에서 만든 것을 가리킬 때 쓴다 (기본: 실행한 폴더의 chroma_db)
# DIARY_DB_PATH=../analysis/chroma_db
# 선택: 개발용 로그 파일(logs/dev_날짜.log) 끄기
# DEV_LOG=0
