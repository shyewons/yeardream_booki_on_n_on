# 이 파일을 .env 로 복사해서 값을 채우세요. .env 는 Git에 올리지 않습니다(.gitignore).
# SSH 터널을 먼저 켜 두세요: ssh -N -L 3307:127.0.0.1:3306 이름@주소 -p 포트
# 비밀번호에 @ : / 같은 기호가 있으면 %40 처럼 바꿔 넣어야 합니다.
DATABASE_URL=mysql+pymysql://DB사용자:DB비밀번호@127.0.0.1:3307/app_db

# 선택: 한 쪽에 보여줄 개수 (기본 책 6, 글 10)
# PAGE_SIZE_BOOKS=6
# PAGE_SIZE_ENTRIES=10
# 선택: 로그인이 붙기 전까지 쓰는 더미 사용자 별명 (기본 dummy_user)
# DUMMY_NICKNAME=dummy_user

# 선택: 교정 모델 사용 (기본 0 = 임시 노드). 1 이면 requirements-models.txt 와 chroma_db 가 필요
# USE_MODELS=0
# 선택: 동화 표현 추천을 언제 할지 (기본 all)
#   all = 맞춤법을 고친 문장에도 추천 / no_correction = 맞춤법이 맞은 문장에만 추천 (파이프라인 run_story 와 같은 기준)
#   모델이 꺼져 있으면(USE_MODELS=0) 임시 예시 문장을 주고, 화면에 '모델이 꺼져 있다'는 안내가 나온다
# STORY_SUGGEST_ON=all
# 선택: 설명문 · 표현 추천 모델 (기본 small). diary_pipeline/config.py 의 EXPLAIN_LLMS 에서 고른다. 바꾼 뒤에는 서버를 껐다 켜야 한다 (--reload 는 .env 를 보지 않음)
#   small = kakaocorp/kanana-1.5-2.1b-instruct-2505  (Kanana 1.5, 2.1B, 2025-05)
#           가볍다. CPU 로도 돌릴 만함 (설명 한 곳에 약 7~9초, 맥 CPU 기준). 메모리 CPU 약 9GB / GPU 약 5GB
#   large = kakaocorp/kanana-2-3b-instruct           (Kanana 2, 3B, 2026-07)
#           한 세대 새 모델이라 지시를 더 잘 따른다 (말투 · 지어낸 설명이 줄 것으로 기대). transformers 4.57 이상 필요
#           GPU 나 맥 mps 권장 (맥 mps 에서 설명 한 곳에 약 3초). 메모리 CPU 약 12GB / GPU 약 6GB, 처음 켤 때 몇 GB 내려받음
#           라이선스가 Kanana Open License 로 small(상업 이용 가능 공개)과 다르다
#   목록에 없는 값을 적으면 그 값을 Hugging Face 모델 이름으로 그대로 쓴다
# EXPLAIN_LLM=small
# 선택: 모델을 돌릴 장치. 비워 두면 자동으로 cuda(엔비디아) → mps(맥 GPU) → cpu 순서로 고른다
#   mps 에서 오류가 나면 cpu 로 강제한다. mps 가 일부 연산을 못 하면 PYTORCH_ENABLE_MPS_FALLBACK=1 로 그 부분만 CPU 로 돌린다
# MODEL_DEVICE=cpu
# PYTORCH_ENABLE_MPS_FALLBACK=1
# 선택: RAG 벡터 DB(chroma_db) 폴더 위치. analysis 쪽에서 만든 것을 가리킬 때 쓴다 (기본: 실행한 폴더의 chroma_db)
# DIARY_DB_PATH=../analysis/chroma_db
# 선택: 개발용 로그 파일(logs/dev_날짜.log) 끄기
# DEV_LOG=0
